# URL of the Express API used by Vite during development and production builds.
# Do not put credentials or other secrets in this file.
VITE_API_BASE_URL="http://localhost:5000"

# Public URL stored in QR labels. For phone scanning, set this to the LAN IP
# or deployed HTTPS URL that the phone can reach, for example:
# VITE_PUBLIC_APP_URL="http://192.168.1.20:5173"
