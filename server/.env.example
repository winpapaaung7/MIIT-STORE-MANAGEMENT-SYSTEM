DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
PORT="5000"
# Set to 1 only when a single trusted reverse proxy (such as Nginx) is in
# front of this API; it enables correct per-client scanner rate limiting.
TRUST_PROXY="1"
CLIENT_ORIGIN="http://localhost:5173"
AUTH_ACCESS_TOKEN_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_OTP_SECRET="replace-with-a-different-random-secret-of-at-least-32-characters"
AUTH_REFRESH_TOKEN_DAYS="30"
# Used only by `npm run seed:database` on a new empty database. It is never
# exported into seed-data.json. Change all seeded user passwords after loading.
SEED_USER_PASSWORD="set-a-temporary-password-of-at-least-12-characters"
# Development-friendly login request limits. Use lower values in production.
AUTH_RATE_LIMIT_WINDOW_MINUTES="15"
AUTH_LOGIN_IP_LIMIT="100"
AUTH_LOGIN_EMAIL_LIMIT="30"
# Public QR/barcode scanner lookup limit per IP. Use a shared limiter when
# deploying more than one API instance.
SCANNER_RATE_LIMIT_WINDOW_MINUTES="1"
SCANNER_RATE_LIMIT="30"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-address@gmail.com"
SMTP_PASS="google-app-password"
EMAIL_FROM="MIIT Store <your-address@gmail.com>"
OTP_EXPIRES_MINUTES="5"
OTP_RESEND_SECONDS="60"
